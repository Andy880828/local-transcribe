# 複製此檔為 .env 並填入你的金鑰（.env 已被 .gitignore 忽略，不會外洩）

# Hugging Face token —— 講者分辨 (pyannote) 必需。
# 取得方式：https://huggingface.co/settings/tokens （read 權限即可）
# 重要：還必須登入後接受以下兩個 gated 模型的授權條款，否則下載會 401：
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# ---- 以下為可選的預設值覆寫（不填則用程式內建預設） ----

# 講者分辨模型。預設 pyannote/speaker-diarization-3.1（需接受其授權）。
# 新版 whisperx 預設改用 pyannote/speaker-diarization-community-1（更新、需另接受授權）。
# DIARIZE_MODEL=pyannote/speaker-diarization-3.1

# Whisper 模型：tiny / base / small / medium / large-v3（中文建議 large-v3）
# WHISPER_MODEL=large-v3

# 轉錄語言代碼（zh=中文）。留空則自動偵測。
# LANGUAGE=zh

# 運算精度：float16（預設，較快）/ int8（較省 VRAM）/ float32
# COMPUTE_TYPE=float16

# 批次大小（VRAM 不足時調小，如 4）
# BATCH_SIZE=8

# ---- 防幻覺 / 轉錄品質旋鈕（預設值已針對會議類長音檔調校，通常不需改）----

# 以前文為解碼條件。false=抗重複幻覺（預設）；true=連貫性較好但易在雜音段重複
# CONDITION_ON_PREVIOUS_TEXT=false
# 禁止重複的 n-gram 大小（0=停用，3=擋掉循環式重複）
# NO_REPEAT_NGRAM_SIZE=3
# 重複懲罰（1.0=無，越大越抗重複）
# REPETITION_PENALTY=1.1
# 壓縮比門檻，超過視為重複段而丟棄
# COMPRESSION_RATIO_THRESHOLD=2.4
# 無語音機率門檻，超過視為靜音略過
# NO_SPEECH_THRESHOLD=0.6

# ---- 中文輸出 ----
# 簡轉繁：s2tw（預設，台灣繁體）/ none（保留 Whisper 原始輸出，可能繁簡混雜）
# CHINESE_CONVERT=s2tw
